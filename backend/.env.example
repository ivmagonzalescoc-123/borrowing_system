# Copy this file to .env and fill in your own values.
# No need to create the database or import schema.sql by hand — the backend
# creates the database, tables, and seed data automatically on `npm run dev`
# / `npm start`, as long as MySQL is running and these credentials are correct.

PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Optional: set this to your deployed frontend's URL (e.g.
# https://your-app.vercel.app) to restrict CORS to just that origin.
# Leave blank for local dev to allow any origin.
FRONTEND_URL=
