# Copy this file to .env and fill in your own values.
# No need to create the database or import schema.sql by hand — the backend
# creates the database, tables, and seed data automatically on `npm run dev`
# / `npm start`, as long as MySQL is running and these credentials are correct.

PORT=5000

# development | production. Controls HTTPS enforcement, whether CORS requires
# FRONTEND_URL to be set, the trust proxy setting, and whether the
# forgot-password OTP is ever returned in an API response (dev/demo only —
# see auth.controller.js).
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# On a fresh local MySQL/XAMPP install this can be any name — the backend
# creates it automatically. On hosted MySQL (Render, Clever Cloud, etc.) it
# must match the database name the provider already assigned you.
DB_NAME=library_db

# Must be a random string of at least 32 characters — the server refuses to
# start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Required in production: your deployed frontend's URL(s), comma-separated
# if there's more than one (e.g. https://your-app.vercel.app). CORS has no
# wildcard fallback — a request from an origin not in this list is rejected.
# Leave blank for local dev to allow http://localhost:5173 only.
FRONTEND_URL=

# Optional. Vercel gives every deployment its own per-push URL in addition
# to your stable FRONTEND_URL (e.g.
# https://borrowing-system-5gew8rl6a-your-team.vercel.app) — a different
# origin every time, so it can never be listed in FRONTEND_URL directly. Set
# this to just the team/account suffix (the part after the random hash) to
# allow any of your own preview deployments through CORS too:
#   VERCEL_PREVIEW_ORIGIN_SUFFIX=your-team.vercel.app
VERCEL_PREVIEW_ORIGIN_SUFFIX=
